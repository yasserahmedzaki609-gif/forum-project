# ============================================================================
# Forum Project — Git ignore rules
# ============================================================================

# ---- Dependencies ----
node_modules/

# ---- Environment (contains secrets) ----
# Explicit entries so that .env.example is NOT ignored.
.env
.env.local
.env.*.local
!.env.example

# ---- Runtime data (SQLite) ----
data/
forum.db
*.db
*.db-journal
*.db-wal
*.db-shm

# ---- TLS certificates (generated at runtime) ----
certs/
key.pem
cert.pem
*.pem

# ---- Media uploads (runtime generated) ----
# Only the ROOT media/ directory (runtime uploads). Do NOT ignore
# src/media/ — that is production code (media pipeline).
/media/

# ---- Test / coverage artifacts ----
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Editor / OS noise ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ---- Build artifacts & Misc ----
dist/
build/
combined_project.txt